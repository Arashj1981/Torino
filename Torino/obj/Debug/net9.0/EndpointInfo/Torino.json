{
  "openapi": "3.0.4",
  "info": {
    "title": "Torino API",
    "description": "Tour management API with JWT Authentication",
    "version": "v1"
  },
  "paths": {
    "/api/Auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/FilterTours/filterByTypeAndDestination": {
      "get": {
        "tags": [
          "FilterTours"
        ],
        "parameters": [
          {
            "name": "tourType",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/TourType"
            }
          },
          {
            "name": "tourDestination",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/FilterTours/filter": {
      "get": {
        "tags": [
          "FilterTours"
        ],
        "parameters": [
          {
            "name": "tourType",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/TourType"
            }
          },
          {
            "name": "tourDestination",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "transportMode",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/TransportMode"
            }
          },
          {
            "name": "durationDays",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Tours": {
      "get": {
        "tags": [
          "Tours"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Tours"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTourCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTourCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTourCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Tours/{id}": {
      "get": {
        "tags": [
          "Tours"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "Tours"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTourCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTourCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTourCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Tours"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateTourCommand": {
        "required": [
          "description",
          "destination",
          "endDate",
          "origin",
          "startDate",
          "title",
          "totelRating",
          "tourDifficulty",
          "tourOrigin",
          "tourType",
          "transportMode"
        ],
        "type": "object",
        "properties": {
          "tourOrigin": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "title": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "minAge": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "maxAge": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "origin": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "destination": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "durationDays": {
            "maximum": 365,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "tourDifficulty": {
            "$ref": "#/components/schemas/TourDifficulty"
          },
          "transportMode": {
            "$ref": "#/components/schemas/TransportMode"
          },
          "totelRating": {
            "$ref": "#/components/schemas/HotelRating"
          },
          "tourType": {
            "$ref": "#/components/schemas/TourType"
          },
          "price": {
            "maximum": 100000000000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "capacity": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "isSpecial": {
            "type": "boolean"
          },
          "isOneDay": {
            "type": "boolean"
          },
          "bestSellingTours": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "domesticTour": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "foreignTour": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "HotelRating": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "type": "integer",
        "format": "int32"
      },
      "LoginCommand": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterCommand": {
        "required": [
          "email",
          "fullname",
          "name",
          "password"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "fullname": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "brithdate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "passport": {
            "type": "boolean"
          },
          "passportNumber": {
            "type": "integer",
            "format": "int32"
          },
          "passportExpiryDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "nationalCode": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          },
          "cardNumber": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "iban": {
            "maxLength": 34,
            "type": "string",
            "nullable": true
          },
          "userRole": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "additionalProperties": false
      },
      "TourDifficulty": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "TourType": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "TransportMode": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5
        ],
        "type": "integer",
        "format": "int32"
      },
      "UpdateTourCommand": {
        "required": [
          "description",
          "destination",
          "endDate",
          "id",
          "origin",
          "startDate",
          "title",
          "totelRating",
          "tourDifficulty",
          "tourOrigin",
          "tourType",
          "transportMode"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tourOrigin": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "title": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "minAge": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "maxAge": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "origin": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "destination": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "durationDays": {
            "maximum": 365,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "tourDifficulty": {
            "$ref": "#/components/schemas/TourDifficulty"
          },
          "transportMode": {
            "$ref": "#/components/schemas/TransportMode"
          },
          "totelRating": {
            "$ref": "#/components/schemas/HotelRating"
          },
          "tourType": {
            "$ref": "#/components/schemas/TourType"
          },
          "price": {
            "maximum": 1000000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "capacity": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "isSpecial": {
            "type": "boolean"
          },
          "isOneDay": {
            "type": "boolean"
          },
          "bestSellingTours": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "domesticTour": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "foreignTour": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserRole": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter: Bearer {your JWT token}",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}